# Copy to .env and fill in your SMTP credentials. Never commit .env.

NODE_ENV=development
PORT=5000

# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Set to 1 when running behind one reverse proxy / load balancer (Nginx, Render, Railway, etc.)
TRUST_PROXY=0

# Demo form rate limit: max submissions per IP per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# SMTP email configuration (Nodemailer)
EMAIL_FROM="WazzupPAP <edetailer@digilateral.com>"
EMAIL_TO=info@digilateral.com
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=edetailer@digilateral.com
EMAIL_PASS=YOUR_SMTP_PASSWORD
