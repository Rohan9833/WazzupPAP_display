# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Use a database user that has readWrite on this database only.
MONGODB_URI=mongodb://127.0.0.1:27017/wazzuppap

# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Set to 1 when running behind one reverse proxy / load balancer (Nginx, Render, Railway, etc.)
TRUST_PROXY=0

# Demo form rate limit: max submissions per IP per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# SMTP email configuration (Nodemailer)
EMAIL_FROM="DocTalk <info@digilateral.com>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Notification destination. Defaults to EMAIL_USER if omitted.
EMAIL_TO=info@digilateral.com
