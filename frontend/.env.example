# Public base URL of the Express API, with no trailing slash.
# Leave empty when the API is served from the same origin (e.g. Nginx proxies /api to Express).
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5000

# Note: every VITE_* variable is bundled into public JavaScript. Never put secrets here.

# Set to true only for static design previews with no backend (the form then explains it can't send).
VITE_PREVIEW_MODE=false
